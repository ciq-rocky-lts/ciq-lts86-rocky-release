[lts]
name=CIQ Rocky Linux $releasever LTS
baseurl=$baseurl1$cloudcontentdir$product/rocky-lts-$releasever.$basearch,$baseurl2$cloudcontentdir$product/rocky-lts-$releasever.$basearch
gpgcheck=1
enabled=1
countme=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CIQ

